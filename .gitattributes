# 仓库里的文本文件统一用 LF，谁在什么系统上克隆都一样
* text=auto eol=lf

# 明确标成二进制，避免被当成文本处理
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# GitHub 语言统计：这个项目是纯手写的，别把数据文件算错
js/app.js linguist-generated=false
js/engine/*.js linguist-generated=false
js/data/*.js linguist-language=JavaScript
